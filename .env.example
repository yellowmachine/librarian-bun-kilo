# ─── Base de datos ────────────────────────────────────────────────────────────
# Librarian tiene su propia base de datos (en local, la de compose.yaml:
# `bun run db:start`, puerto 5436). Todo en el schema public: las tablas de
# Better Auth y las de la app, creadas por las migraciones de drizzle/.
# La app se conecta como app_user (lo crea scripts/init.sh; RLS se le aplica).
DATABASE_URL="postgres://app_user:app_user@localhost:5436/librarian"

# Migraciones: el dueño de la base (crea tablas, políticas y funciones).
MIGRATION_DATABASE_URL="postgres://librarian:librarian@localhost:5436/librarian"

# Solo docker-compose.yml (producción) y compose.yaml: contraseñas del dueño y
# de app_user. init.sh solo corre con el volumen vacío.
# POSTGRES_PASSWORD=""
# APP_DB_PASSWORD=""

# ─── App ──────────────────────────────────────────────────────────────────────
# URL pública de la app, sin trailing slash.
# Desarrollo: http://localhost:5173 (o https://librarian-dev.scholio.review con el túnel)
# Producción: https://librarian.scholio.review
ORIGIN="http://localhost:5173"

# Puerto del servidor. Por defecto 3000.
PORT=3000

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ─── Cuentas ──────────────────────────────────────────────────────────────────
# Librarian funciona por invitación. Al arrancar sin ninguna cuenta, invita a este
# email (le manda el enlace y lo escribe en el log). Ver README → Accounts.
ADMIN_EMAIL=""

# ─── Seilide (opcional) ───────────────────────────────────────────────────────
# «Entrar con Seilide» (OpenID Connect). Sin las tres, el botón no sale.
# Salen de /admin/apps en Seilide (cliente que NO es «para familias»), con la
# vuelta https://<ORIGIN>/api/auth/oauth2/callback/seilide — ver README → Seilide.
# Seilide solo acepta vueltas https que no sean localhost: en desarrollo, el
# túnel (`bun run tunnel` + `bun run dev:tunnel`).
SEILIDE_URL="https://nube.scholio.review"
SEILIDE_CLIENT_ID=""
SEILIDE_CLIENT_SECRET=""

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Necesario para verificación de email y notificaciones de préstamos.
# Si no se define SMTP_HOST, los emails se omiten silenciosamente.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Librarian <no-reply@scholio.review>"

# ─── Sentry (opcional) ────────────────────────────────────────────────────────
SENTRY_DSN=""
PUBLIC_SENTRY_DSN=""

# ─── KMS (claves de OpenRouter de los usuarios) ──────────────────────────────
# Cifra la clave de OpenRouter que cada usuario conecta en /account (escanear
# estanterías, sugerir etiquetas, buscar portadas con IA). Generar con:
# openssl rand -base64 32. Si cambia, las claves guardadas dejan de valer.
KMS_MASTER_KEY=""

# ─── Google Books (búsqueda de portadas para libros manuales) ─────────────────
# Opcional. Sin clave se usa la cuota anónima compartida de Google, que suele
# estar agotada (HTTP 429). Crear una API key con "Books API" habilitada en
# https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=""
